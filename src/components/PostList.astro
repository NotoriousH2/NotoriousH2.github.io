---
import type { Post } from '../lib/posts';
import PostRow from './PostRow.astro';

interface Props {
  posts: Post[];
  dateFormat?: 'full' | 'short';
  /** 글이 하나도 없을 때 대신 보여줄 문장. */
  empty?: string;
}

const { posts, dateFormat = 'full', empty = '아직 올린 글이 없습니다.' } = Astro.props;
---

{
  posts.length > 0 ? (
    <ul class="list">
      {posts.map((post) => (
        <PostRow post={post} dateFormat={dateFormat} />
      ))}
    </ul>
  ) : (
    <p class="meter empty">{empty}</p>
  )
}

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .empty {
    padding-block: 1.5rem;
  }
</style>
