---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE } from '../consts';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
}

const { title, description, type, publishedTime } = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <BaseHead title={title} description={description} type={type} publishedTime={publishedTime} />
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <Header />
    <main id="main" class="shell rise" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
