---
import TagLink from '../components/TagLink.astro';
import { CATEGORIES } from '../data/taxonomy';
import { formatDate, postCategories, type Post } from '../lib/posts';
import Base from './Base.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, summary, pubDate, updatedDate, tags } = post.data;
const categories = postCategories(post);
---

<Base title={title} description={summary} type="article" publishedTime={pubDate}>
  <article>
    <header class="post-head">
      <p class="meter post-head__meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {
          categories.map((id) => {
            const category = CATEGORIES.find((c) => c.id === id)!;
            return (
              <>
                <span class="sep" aria-hidden="true">/</span>
                <a href={`/categories/${id}`} style={`--tag-color: var(--cat-${id})`} class="cat">
                  {category.label}
                </a>
              </>
            );
          })
        }
      </p>
      <h1>{title}</h1>
      <p class="post-head__summary">{summary}</p>
      {
        updatedDate && (
          <p class="meter meter--faint post-head__updated">
            {formatDate(updatedDate)} 수정
          </p>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>

    <footer class="post-foot">
      <div class="tag-row">
        {tags.map((tag) => <TagLink tag={tag} />)}
      </div>
      <p class="meter meter--faint">
        <a href="/archive">← 아카이브</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="/graph">그래프에서 보기</a>
      </p>
    </footer>
  </article>
</Base>

<style>
  .post-head {
    padding-bottom: 1.6rem;
    border-bottom: 1px solid var(--line-strong);
    margin-bottom: 2.4rem;
  }

  .post-head__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.9rem;
  }

  .cat {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    text-decoration: none;
    color: var(--text-muted);
  }

  .cat::before {
    content: '';
    width: 0.42em;
    height: 0.42em;
    border-radius: 50%;
    background: var(--tag-color);
  }

  .cat:hover {
    color: var(--text);
  }

  .sep {
    color: var(--line-strong);
  }

  h1 {
    font-size: clamp(1.55rem, 1.1rem + 2vw, 2.15rem);
    line-height: 1.32;
  }

  .post-head__summary {
    margin: 0.8rem 0 0;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-muted);
  }

  .post-head__updated {
    margin: 0.7rem 0 0;
  }

  .post-foot {
    margin-top: var(--rhythm);
    padding-top: 1.4rem;
    border-top: 1px solid var(--line-strong);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .post-foot p {
    margin: 0;
    display: flex;
    gap: 0.5rem;
  }
</style>
