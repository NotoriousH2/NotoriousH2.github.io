---
import { CONTACT, SITE } from '../consts';
import { CORPORATE, LECTURES } from '../data/lectures';
import { CATEGORIES } from '../data/taxonomy';
import { TOOLS } from '../data/tools';
import Base from '../layouts/Base.astro';
import { categoryUsage, getPosts } from '../lib/posts';

const posts = await getPosts();
const byCategory = categoryUsage(posts);

// '다루는 주제'는 이 페이지의 범례 역할도 한다. 이 화면에 실제로 점이 찍히는 범주만
// 담아야 한다. 발표는 /media로 옮겼으므로 여기서는 글과 강의만 센다.
const usedIds = new Set([...byCategory.keys(), ...LECTURES.map((l) => l.category)]);
const activeCategories = CATEGORIES.filter((c) => usedIds.has(c.id));

// 강의는 '어디서 들을 수 있는가'로 묶는다. 범주는 항목마다 점으로 붙어 축을 공유한다.
const lectureGroups = [...new Set(LECTURES.map((l) => `${l.provider} · ${l.format}`))].map((key) => ({
  key,
  items: LECTURES.filter((l) => `${l.provider} · ${l.format}` === key),
}));

const categoryLabel = (id: string) => CATEGORIES.find((c) => c.id === id)?.label ?? id;
---

<Base title="소개" description={SITE.description}>
  <header class="page-head">
    <p class="page-head__eyebrow">
      <span class="meter">소개</span>
      <span class="meter meter--faint">{SITE.org}</span>
    </p>
    <h1>{SITE.author}</h1>
  </header>

  <section class="bio">
    <p>
      노토랩({SITE.org}) 대표입니다. 기업과 연구소에서 LLM 파인튜닝, AI 에이전트, RAG를
      강의하고, 모델 도입을 자문합니다.
    </p>
    <p>
      KAIST 전산학부 학사, 서울대학교 컴퓨터공학부 박사. 그래프와 사용자 행동 데이터로
      소셜 링크 추론과 스팸 탐지를 연구했습니다.
    </p>
    <p>
      강의와 자문 문의는 아래 메일로 주세요.
    </p>
  </section>

  <section class="block">
    <div class="section-head">
      <h2>연락</h2>
    </div>
    <dl class="specs">
      {
        CONTACT.map((item) => (
          <div class="spec">
            <dt class="meter meter--faint">{item.label}</dt>
            <dd>
              <a class="meter" href={item.href}>
                {item.text}
              </a>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  {
    activeCategories.length > 0 && (
      <section class="block">
        <div class="section-head">
          <h2>다루는 주제</h2>
        </div>
        <dl class="specs">
          {activeCategories.map((category) => (
            <div class="spec" style={`--tag-color: var(--cat-${category.id})`}>
              <dt class="meter dot">
                {byCategory.has(category.id) ? (
                  <a href={`/categories/${category.id}`}>{category.label}</a>
                ) : (
                  category.label
                )}
              </dt>
              <dd>
                <span>{category.blurb}</span>
                {byCategory.has(category.id) && (
                  <span class="meter meter--faint">글 {byCategory.get(category.id)!.length}편</span>
                )}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  {
    LECTURES.length > 0 && (
      <section class="block">
        <div class="section-head">
          <h2>강의</h2>
          <span class="meter meter--faint">공개 {LECTURES.length}개</span>
        </div>
        {lectureGroups.map((group) => (
          <div class="group">
            <h3 class="meter group__label">{group.key}</h3>
            <dl class="specs">
              {group.items.map((lecture) => (
                <div class="spec" style={`--tag-color: var(--cat-${lecture.category})`}>
                  <dt class="meter dot">
                    {lecture.year}
                    <span class="visually-hidden">, 범주 {categoryLabel(lecture.category)}</span>
                  </dt>
                  <dd>
                    <span class="item__title">
                      <a href={lecture.href}>{lecture.title}</a>
                    </span>
                    {lecture.extra && (
                      <span class="meter meter--faint">
                        <a href={lecture.extra.href}>{lecture.extra.label} →</a>
                      </span>
                    )}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        ))}
      </section>
    )
  }

  {
    CORPORATE.length > 0 && (
      <section class="block">
        <div class="section-head">
          <h2>기업 · 기관 교육</h2>
        </div>
        <p class="note">
          파인튜닝(CPT · SFT · PEFT · DPO · GRPO), 에이전트와 컨텍스트 엔지니어링, RAG,
          평가와 서빙을 주로 다룹니다.
        </p>
        <dl class="specs">
          {CORPORATE.map((entry) => (
            <div class="spec">
              <dt class="meter meter--faint">{entry.year}</dt>
              <dd>
                <span class="orgs">{entry.orgs.join(' · ')}</span>
              </dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  {
    TOOLS.length > 0 && (
      <section class="block">
        <div class="section-head">
          <h2>도구</h2>
          <span class="meter meter--faint">{TOOLS.length}개</span>
        </div>
        <dl class="specs">
          {TOOLS.map((tool) => (
            <div class="spec">
              <dt class="meter meter--faint">{tool.kind}</dt>
              <dd>
                <span class="item__title">
                  <a href={tool.href}>{tool.name}</a>
                  {tool.repo && (
                    <a class="meter meter--faint repo" href={tool.repo}>
                      소스
                    </a>
                  )}
                </span>
                <span class="item__summary">{tool.summary}</span>
              </dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

</Base>

<style>
  .bio p {
    margin: 0 0 0.9rem;
    max-width: 34rem;
  }

  .block {
    margin-top: var(--rhythm);
  }

  .note {
    margin: 1rem 0 0;
    max-width: 34rem;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .group {
    margin-top: 1.8rem;
  }

  .group__label {
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text-faint);
    margin-bottom: 0.4rem;
  }

  .group .specs {
    margin-top: 0;
  }

  .repo {
    font-weight: 400;
  }

  .item__summary {
    color: var(--text-muted);
  }

  .orgs {
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .sep {
    color: var(--line-strong);
    margin-inline: 0.45em;
  }

</style>
