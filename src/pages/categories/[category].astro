---
import CategoryTagList from '../../components/CategoryTagList.astro';
import PostList from '../../components/PostList.astro';
import { TAGS, getCategory, type CategoryId, type TagId } from '../../data/taxonomy';
import Base from '../../layouts/Base.astro';
import { categoryUsage, getPosts, type Post } from '../../lib/posts';

/** 글이 있는 범주만 페이지를 만든다. */
export async function getStaticPaths() {
  const posts = await getPosts();
  const usage = categoryUsage(posts);
  return [...usage.entries()].map(([category, tagged]) => ({
    params: { category },
    props: { category, posts: tagged },
  }));
}

interface Props {
  category: CategoryId;
  posts: Post[];
}

const { category: categoryId, posts } = Astro.props;
const category = getCategory(categoryId);

const usage = new Map<TagId, number>();
for (const post of posts) {
  for (const raw of post.data.tags) {
    const tag = raw as TagId;
    if (TAGS[tag].category !== categoryId) continue;
    usage.set(tag, (usage.get(tag) ?? 0) + 1);
  }
}
---

<Base title={category.label} description={category.blurb}>
  <header class="page-head" style={`--tag-color: var(--cat-${categoryId})`}>
    <p class="page-head__eyebrow">
      <span class="meter">범주</span>
      <span class="meter meter--faint">{posts.length}편</span>
    </p>
    <h1><span class="rule" aria-hidden="true"></span>{category.label}</h1>
    <p class="page-head__lede">{category.blurb}</p>
  </header>

  <PostList posts={posts} />

  {
    usage.size > 0 && (
      <section class="tags">
        <div class="section-head">
          <h2>이 범주의 태그</h2>
        </div>
        <CategoryTagList usage={usage} />
      </section>
    )
  }
</Base>

<style>
  h1 {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  /* 범주 색은 제목 옆 짧은 선으로만 나타난다. 넓은 면에는 칠하지 않는다. */
  .rule {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--tag-color);
    flex: none;
  }

  .tags {
    margin-top: var(--rhythm);
  }
</style>
