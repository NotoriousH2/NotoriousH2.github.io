---
import CategoryTagList from '../components/CategoryTagList.astro';
import TagGraph from '../components/TagGraph.astro';
import Base from '../layouts/Base.astro';
import { buildGraph } from '../lib/graph';
import { getPosts, tagUsage } from '../lib/posts';

const posts = await getPosts();
const graph = buildGraph(posts);
const usage = new Map([...tagUsage(posts).entries()].map(([tag, tagged]) => [tag, tagged.length]));
---

<Base
  title="주제 지도"
  description="태그 공출현 관계도. 노드는 태그, 크기는 글 수, 선은 같은 글에 함께 나온 빈도입니다."
>
  <header class="page-head">
    <p class="page-head__eyebrow">
      <span class="meter meter--faint">태그 {graph.nodes.length}개</span>
    </p>
    <h1>주제 지도</h1>
    <p class="page-head__lede">
      같은 글에 함께 나온 태그를 선으로 이었습니다. 노드를 누르면 그 태그의 글 목록으로 갑니다.
    </p>
  </header>

  <TagGraph graph={graph} />

  <section class="fallback">
    <div class="section-head">
      <h2>범주별 태그</h2>
    </div>
    <CategoryTagList usage={usage} />
  </section>
</Base>

<style>
  .fallback {
    margin-top: var(--rhythm);
  }
</style>
